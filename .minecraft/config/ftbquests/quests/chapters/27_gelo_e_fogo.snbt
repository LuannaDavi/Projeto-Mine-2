	quests: [
		{
			description: [
				"§7Gelo, fogo e raio caem do céu com asas. Nas profundezas, uma"
				"§7rainha maldita espera atrás de um portal que ninguém deveria"
				"§7ter aberto a primeira vez."
				""
				"§eDragões, mitologia grega inteira, trolls, fadas, e uma dimensão"
				"§eparalela cheia de coisas que só querem sua morte."
				""
				"§6Dica: §7comece pesquisando cobre e prata — são os minérios"
				"§7básicos desse mod, achados perto da superfície."
				""
				"§7Esse capítulo começa trancado até você decidir abri-lo."
				"§7Entregue o item abaixo pra revelar todas as missões de uma vez."
			]
			icon: "iceandfire:silver_ingot"
