			title: "Abrir Capitulo"
			x: 0.0d
			y: -2.0d
		}
		{
			dependencies: ["811C8E414BA8B2A0"]
			description: [
				"§7Uma estrutura oca de tijolos vitrificados, com um dreno na base"
				"§7e uma torneira apontando pra fora. Derreta minério aqui e o metal"
				"§7líquido sai pronto pro molde — sem forja, sem martelo, só calor."
				""
				"§6Dica: §7quanto maior a fundição, mais metal derrete de uma vez. Comece pequeno — 3x3x3 já funciona."
			]
			hide_until_deps_complete: true
