	quests: [
		{
			description: [
				"§7Ferramentas modulares: cabo, cabeça e extra, cada peça"
				"§7trocável, cada material com propriedades próprias."
				"§7Combine errado e a ferramenta é ruim. Combine certo e"
				"§7ela supera qualquer coisa feita numa bigorna comum."
				""
				"§eDa primeira fundição ao Manyullyn, passando por bronze,"
				"§eaço e uma escória de slime que ninguém pediu pra existir."
				""
				"§6Dica: §7monte a Fundição antes de mais nada — sem ela,"
				"§7nenhuma liga desse capítulo é possível."
				""
				"§7Esse capítulo começa trancado até você decidir abri-lo."
				"§7Entregue o item abaixo pra revelar todas as missões de uma vez."
			]
			icon: "tconstruct:pattern"
			id: "811C8E414BA8B2A0"
			rewards: [{
				id: "0280355A7EBD1607"
				type: "xp"
