			description: [
				"§c§lVocê chegou até aqui."
				""
				"§7Dominou a engenharia mecânica, as leis da física quântica,"
				"§7a magia arcana, construiu um império e forjou o arsenal"
				"§7de um guerreiro lendário."
				""
				"§7Isso por si só já diz muito."
				"§7Mas chegar não é suficiente."
				""
				"§7Estes desafios não foram feitos para serem rápidos."
				"§7Cada um exige horas de preparação, recursos raros"
				"§7e domínio real dos sistemas deste modpack."
				""
				"§7Não existe atalho. Não existe sorte."
				"§7Só trabalho, paciência e vontade."
				""
				"§c§lProve que você merece o título."
			]
			hide_until_deps_complete: true
