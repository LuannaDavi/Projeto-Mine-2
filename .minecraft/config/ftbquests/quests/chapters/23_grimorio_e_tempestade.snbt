	quests: [
		{
			description: [
				"§7Um grimório em branco não é fraco — é uma pergunta esperando"
				"§7resposta. Runas, afinidades e escolas inteiras de magia cabem"
				"§7dentro de páginas que ainda não foram escritas."
				""
				"§eDo primeiro grimório de cobre ao Necronomicon, passando por"
				"§emares, tempestades sônicas e uma espada de luz que ninguém"
				"§esabe explicar como parou aqui."
				""
				"§6Dica: §7depois de aberto, escolha uma escola pra começar — não"
				"§7precisa aprender todas na ordem. É o seu grimório."
				""
				"§7Esse capítulo começa trancado até você decidir abri-lo."
				"§7Entregue o item abaixo pra revelar todas as missões de uma vez."
			]
			icon: "irons_spellbooks:arcane_essence"
			id: "5FE5C4FA0EF0C15F"
			rewards: [{
				id: "325365716B6F888A"
				type: "xp"
				xp: 50
