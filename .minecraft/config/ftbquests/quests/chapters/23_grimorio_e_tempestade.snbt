		}
		{
			dependencies: ["5FE5C4FA0EF0C15F"]
			description: [
				"§7Todo mago começa com páginas vazias. O grimório de ferro é"
				"§7o mais simples — poucas runas cabem nele, mas é o suficiente"
				"§7pra aprender a base."
				""
				"§6Dica: §7grimórios se fazem numa mesa de trabalho comum. A parte"
				"§7difícil vem depois, na hora de escrever magia neles."
			]
